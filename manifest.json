{
  "id": "local-task-monitor",
  "name": "本机任务监控",
  "version": "0.5.0",
  "minAppVersion": "1.1.1",
  "tier": "js",
  "author": "BobbyBian97",
  "repo": "BobbyBian97/ccgui-plugin-local-task-monitor",
  "license": "MIT",
  "description": "监控 CC GUI 进程树与可归属侧栏工作区的监听服务：PID、项目、端口、CPU、内存；默认只显示当前项目，可切换项目或全部；工作区服务可经二次确认停止或重启，进程树保持只读。",
  "sdkVersion": ">=0.3.16",
  "permissions": [
    "ui:panel-tab",
    "ui:settings-section",
    "exec:powershell",
    "host:workspace",
    "storage"
  ],
  "icon": "docs/icon.png",
  "screenshots": [
    "docs/screenshot-1-panel.png",
    "docs/screenshot-2-settings.png"
  ],
  "keywords": [
    "process",
    "port",
    "task",
    "workspace",
    "进程",
    "端口",
    "服务",
    "任务监控"
  ]
}
